#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
shell_root="${OMARCHY_SHELL_ROOT:-/usr/share/omarchy/shell}"

command -v quickshell >/dev/null 2>&1 || {
  printf 'TRAFFIC QML RUNTIME: BLOCKED (quickshell is unavailable)\n' >&2
  exit 2
}
[[ -d $shell_root/Commons && -d $shell_root/Ui ]] || {
  printf 'TRAFFIC QML RUNTIME: BLOCKED (Omarchy imports are unavailable)\n' >&2
  exit 2
}

test_root="$(mktemp -d /tmp/proton-traffic-qml.XXXXXX)"
cleanup() {
  rm -rf -- "$test_root"
}
trap cleanup EXIT
mkdir -m 700 "$test_root/runtime" "$test_root/config"

cp "$root"/*.qml "$test_root/"
cp -a "$root/components" "$root/assets" "$test_root/"
cp "$root/tests/qml/traffic-shell.qml" "$test_root/shell.qml"
ln -s "$shell_root/Commons" "$test_root/Commons"
ln -s "$shell_root/Ui" "$test_root/Ui"

set +e
output="$(
  env QT_QPA_PLATFORM=offscreen \
    XDG_RUNTIME_DIR="$test_root/runtime" \
    XDG_CONFIG_HOME="$test_root/config" \
    quickshell --no-color -p "$test_root" 2>&1
)"
quickshell_status=$?
set -e
if (( quickshell_status != 0 )); then
  printf '%s\n' "$output" >&2
  printf 'TRAFFIC QML RUNTIME: quickshell exited %s\n' "$quickshell_status" >&2
  exit 1
fi
result="$(printf '%s\n' "$output" | grep 'TRAFFIC_QML' | tail -n 1)"
[[ $result == *'TRAFFIC_QML true true true true true true true true true true'* ]] || {
  printf '%s\n' "$output" >&2
  printf 'TRAFFIC QML RUNTIME: unexpected result\n' >&2
  exit 1
}
if printf '%s\n' "$output" | grep -Eiq \
  'ReferenceError|TypeError|Cannot assign|Unable to assign|is not a type|Binding loop|failed to load'; then
  printf '%s\n' "$output" >&2
  printf 'TRAFFIC QML RUNTIME: QML error\n' >&2
  exit 1
fi

printf 'TRAFFIC QML RUNTIME: PASS\n'
