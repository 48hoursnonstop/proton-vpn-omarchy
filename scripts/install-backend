#!/usr/bin/env bash
set -euo pipefail
export PATH='/usr/bin'

readonly PACKAGE_NAME='proton-vpn-omarchy'
readonly TARGET_VERSION='0.8.9-1'
readonly PACKAGE_FILE="${PACKAGE_NAME}-${TARGET_VERSION}-x86_64.pkg.tar.zst"
readonly RELEASE_BASE='https://github.com/48hoursnonstop/proton-vpn-omarchy-core/releases/download/v0.8.9'
readonly RELEASE_FINGERPRINT='4D0124DE09788D29E3A8798B12BE3422BDA2422C'
readonly SOURCE_REF='refs/tags/v0.8.9'
readonly SOURCE_COMMIT='ee0a01f4aa8ab485a4692b4313c86dd785f15c46'
readonly PACKAGE_BYTES=4315077
readonly PACKAGE_SHA256='6cd67001a4f6f6949643c9c7df96601bdee5a431aacb09c39698d0fe968afc62'
readonly SIGNATURE_BYTES=119
readonly SIGNATURE_SHA256='c2a2baacec042fb1a593ce1f1959414d88a53e86140486611b335806d32cbf86'
readonly ATTESTATION_FILE="${PACKAGE_FILE}.intoto.jsonl"
readonly ATTESTATION_BYTES=11588
readonly ATTESTATION_SHA256='215b90e0a137db6537b555eb0299e949e32af161aebe76fabf33b078edc0fba6'
readonly SIGNER_WORKFLOW='48hoursnonstop/proton-vpn-omarchy-core/.github/workflows/release.yml'

mode="${1:---install}"
case "$mode" in
  --check | --install | --verify-only) ;;
  *) printf 'Usage: %s [--check|--install|--verify-only]\n' "$0" >&2; exit 2 ;;
esac

if [[ $mode == --check ]]; then
  command -v pacman >/dev/null 2>&1 || exit 1
  command -v vercmp >/dev/null 2>&1 || exit 1
  installed_version="$(pacman -Q "$PACKAGE_NAME" 2>/dev/null | awk '{ print $2 }' || true)"
  [[ -n $installed_version ]] || exit 1
  printf '%s\n' "$installed_version"
  (( $(vercmp "$installed_version" "$TARGET_VERSION") >= 0 ))
  exit
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
plugin_dir="$(dirname -- "$script_dir")"
public_key="$plugin_dir/RELEASE-SIGNING-KEY.asc"
runtime_dir="${XDG_RUNTIME_DIR:-}"
work_dir=''
progress=0
error_code='unexpected_error'

write_status() {
  local state="$1"
  local value="$2"
  local code="${3:-}"
  printf '{"version":1,"state":"%s","progress":%d,"code":"%s"}\n' \
    "$state" "$value" "$code"
}

set_stage() {
  progress="$1"
  write_status "$2" "$progress"
}

fail() {
  error_code="$1"
  shift
  printf 'proton-vpn-omarchy-installer: %s\n' "$*" >&2
  exit 1
}

download_exact() {
  local url="$1"
  local destination="$2"
  local expected_bytes="$3"
  local expected_sha256="$4"
  local download_error="$5"
  local label="$6"
  local file_blocks
  local actual_bytes
  local actual_sha256

  (( expected_bytes > 0 )) && [[ $expected_sha256 =~ ^[0-9a-f]{64}$ ]] ||
    fail release_metadata_invalid "Pinned $label release metadata is incomplete."
  file_blocks=$(((expected_bytes + 511) / 512))
  if ! (
    ulimit -f "$file_blocks"
    exec curl --fail --location --silent --show-error --remove-on-error \
      --proto '=https' --proto-redir '=https' --tlsv1.2 \
      --retry 3 --retry-all-errors --connect-timeout 15 --max-time 300 \
      --max-filesize "$expected_bytes" --output "$destination" "$url"
  ); then
    fail "$download_error" "The $label could not be downloaded within its pinned size limit."
  fi
  [[ -f $destination && ! -L $destination ]] ||
    fail "$download_error" "The downloaded $label is not a regular file."
  actual_bytes="$(stat -c '%s' -- "$destination")"
  [[ $actual_bytes == "$expected_bytes" ]] ||
    fail release_size_mismatch "The $label does not have its pinned size."
  actual_sha256="$(sha256sum -- "$destination")"
  actual_sha256="${actual_sha256%% *}"
  [[ $actual_sha256 == "$expected_sha256" ]] ||
    fail release_digest_mismatch "The $label does not match its pinned SHA-256 digest."
}

cleanup() {
  if [[ -n $work_dir && -n $runtime_dir &&
        $work_dir == "$runtime_dir"/proton-vpn-omarchy-install.* ]]; then
    rm -rf -- "$work_dir"
  fi
}

on_exit() {
  local result=$?
  set +e
  if (( result != 0 )); then
    write_status error "$progress" "$error_code"
  fi
  cleanup
}
trap on_exit EXIT

[[ ${EUID:-$(id -u)} -ne 0 ]] || fail run_as_user 'Run the installer as the desktop user, not root.'
[[ -n $runtime_dir && $runtime_dir == /* && -d $runtime_dir && ! -L $runtime_dir &&
   -O $runtime_dir ]] ||
  fail runtime_unavailable 'XDG_RUNTIME_DIR is unavailable or is not owned by this user.'

umask 077
# Lock the already-validated runtime-directory inode. No predictable lock file
# is opened, followed, truncated or left stale after a crash.
exec 9<"$runtime_dir"
flock -n 9 || fail already_running 'Another backend installation is already running.'

set_stage 5 preflight

[[ -f /etc/arch-release ]] || fail unsupported_system 'Arch Linux is required.'
[[ $(uname -m) == x86_64 ]] || fail unsupported_architecture 'This release requires x86-64.'
[[ -r $public_key ]] || fail signing_key_missing 'The embedded release signing key is missing.'

for command_name in curl flock gpg pacman pkexec sha256sum stat systemctl vercmp; do
  command -v "$command_name" >/dev/null 2>&1 ||
    fail missing_requirement "Required command is unavailable: $command_name"
done

if [[ ! -x /usr/bin/gh ]]; then
  set_stage 10 installing_verifier
  if ! pkexec /usr/bin/pacman --noconfirm --needed -S github-cli \
       >/dev/null 2>&1; then
    fail verifier_install_failed 'The Arch-signed GitHub attestation verifier could not be installed.'
  fi
fi
[[ -x /usr/bin/gh ]] ||
  fail verifier_unavailable 'GitHub artifact attestation verification is unavailable.'

installed_version="$(pacman -Q "$PACKAGE_NAME" 2>/dev/null | awk '{ print $2 }' || true)"
if [[ $mode == --install && -n $installed_version ]] &&
   (( $(vercmp "$installed_version" "$TARGET_VERSION") >= 0 )); then
  set_stage 85 configuring
  [[ -x /usr/bin/proton-omarchy-setup ]] ||
    fail setup_missing 'The installed package does not contain proton-omarchy-setup.'
  /usr/bin/proton-omarchy-setup backend >/dev/null 2>&1 ||
    fail backend_configuration_failed 'The backend user services could not be configured.'
  systemctl --user reset-failed proton-omarchy-agent.service \
    proton-omarchy-agent.socket >/dev/null 2>&1 || true
  systemctl --user start proton-omarchy-agent.socket >/dev/null 2>&1 ||
    fail backend_start_failed 'The backend user socket could not be started.'
  set_stage 100 complete
  exit 0
fi

set_stage 15 verifying_key
primary_fingerprint="$(
  gpg --batch --show-keys --with-colons "$public_key" |
    awk -F: '$1 == "fpr" { print $10; exit }'
)"
primary_count="$(
  gpg --batch --show-keys --with-colons "$public_key" |
    awk -F: '$1 == "pub" { count += 1 } END { print count + 0 }'
)"
[[ $primary_count == 1 && $primary_fingerprint == "$RELEASE_FINGERPRINT" ]] ||
  fail signing_key_mismatch 'The embedded signing key does not match the pinned fingerprint.'

work_dir="$(mktemp -d "$runtime_dir/proton-vpn-omarchy-install.XXXXXX")"
package_path="$work_dir/$PACKAGE_FILE"
signature_path="$work_dir/release-signature.sig"
attestation_path="$work_dir/$ATTESTATION_FILE"
verification_home="$work_dir/gnupg"
verification_status="$work_dir/gpg-status"

set_stage 25 downloading_package
download_exact "$RELEASE_BASE/$PACKAGE_FILE" "$package_path" \
  "$PACKAGE_BYTES" "$PACKAGE_SHA256" package_download_failed 'backend package'

set_stage 45 downloading_signature
download_exact "$RELEASE_BASE/$PACKAGE_FILE.sig" "$signature_path" \
  "$SIGNATURE_BYTES" "$SIGNATURE_SHA256" signature_download_failed 'package signature'

set_stage 55 downloading_attestation
download_exact "$RELEASE_BASE/$ATTESTATION_FILE" "$attestation_path" \
  "$ATTESTATION_BYTES" "$ATTESTATION_SHA256" attestation_download_failed \
  'build-provenance bundle'

set_stage 60 verifying_provenance
mkdir -m 0700 "$work_dir/gh"
if ! GH_CONFIG_DIR="$work_dir/gh" /usr/bin/gh attestation verify "$package_path" \
     --bundle "$attestation_path" \
     --repo 48hoursnonstop/proton-vpn-omarchy-core \
     --signer-workflow "$SIGNER_WORKFLOW" \
     --source-ref "$SOURCE_REF" \
     --source-digest "$SOURCE_COMMIT" \
     --deny-self-hosted-runners >/dev/null 2>&1; then
  fail provenance_invalid 'The package is not bound to the pinned release workflow and source tag.'
fi

mkdir -m 0700 "$verification_home"
GNUPGHOME="$verification_home" gpg --batch --quiet --import "$public_key" ||
  fail signing_key_import_failed 'The pinned signing key could not be imported.'

set_stage 68 verifying_package
if ! GNUPGHOME="$verification_home" gpg --batch --status-fd 1 \
     --verify "$signature_path" "$package_path" >"$verification_status" 2>/dev/null; then
  fail signature_invalid 'The downloaded package signature is invalid.'
fi
verified_primary="$(
  awk '$1 == "[GNUPG:]" && $2 == "VALIDSIG" { print $NF; exit }' \
    "$verification_status"
)"
[[ $verified_primary == "$RELEASE_FINGERPRINT" ]] ||
  fail signature_key_mismatch 'The package was not signed by the pinned release key.'

package_identity="$(pacman -Qp "$package_path" 2>/dev/null || true)"
[[ $package_identity == "$PACKAGE_NAME $TARGET_VERSION" ]] ||
  fail package_identity_mismatch 'The signed package has an unexpected name or version.'

if [[ $mode == --verify-only ]]; then
  set_stage 100 verified
  exit 0
fi

set_stage 72 awaiting_authorization
set +e
pkexec /usr/bin/pacman --noconfirm -U "$package_path" >/dev/null 2>&1
install_result=$?
set -e
case "$install_result" in
  0) ;;
  126) fail authorization_cancelled 'Administrative authorization was cancelled.' ;;
  127) fail authorization_failed 'Administrative authorization could not be obtained.' ;;
  *) fail package_install_failed "pacman failed with status $install_result." ;;
esac

set_stage 88 configuring
installed_version="$(pacman -Q "$PACKAGE_NAME" 2>/dev/null | awk '{ print $2 }' || true)"
[[ -n $installed_version ]] &&
  (( $(vercmp "$installed_version" "$TARGET_VERSION") >= 0 )) ||
  fail package_install_incomplete 'The expected backend package is not installed.'
[[ -x /usr/bin/proton-omarchy-setup ]] ||
  fail setup_missing 'The installed package does not contain proton-omarchy-setup.'

/usr/bin/proton-omarchy-setup backend >/dev/null 2>&1 ||
  fail backend_configuration_failed 'The backend user services could not be configured.'
set_stage 96 starting_backend
systemctl --user reset-failed proton-omarchy-agent.service \
  proton-omarchy-agent.socket >/dev/null 2>&1 || true
if systemctl --user is-active proton-omarchy-agent.service >/dev/null 2>&1; then
  systemctl --user restart proton-omarchy-agent.service >/dev/null 2>&1 ||
    fail backend_start_failed 'The backend user service could not be restarted.'
fi
systemctl --user start proton-omarchy-agent.socket >/dev/null 2>&1 ||
  fail backend_start_failed 'The backend user socket could not be started.'

set_stage 100 complete
