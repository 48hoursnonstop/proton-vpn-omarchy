#!/usr/bin/env bash
set -euo pipefail
export PATH='/usr/bin'

readonly PACKAGE_NAME='proton-vpn-omarchy'
readonly PLUGIN_ID='proton.omarchy'
readonly OWNED_CONNECTION_STABLE_ID='proton-omarchy-rust-v2'

mode="${1:---launch}"
case "$mode" in
  --launch | --worker) ;;
  *) printf 'Usage: %s [--launch|--worker]\n' "$0" >&2; exit 2 ;;
esac

fail() {
  printf 'proton-vpn-omarchy-uninstall: %s\n' "$*" >&2
  exit 1
}

valid_runtime_dir() {
  [[ -n ${XDG_RUNTIME_DIR:-} && $XDG_RUNTIME_DIR == /* &&
     -d $XDG_RUNTIME_DIR && ! -L $XDG_RUNTIME_DIR && -O $XDG_RUNTIME_DIR ]]
}

launch_worker() {
  [[ ${EUID:-$(id -u)} -ne 0 ]] || fail 'run this as the desktop user, not root'
  valid_runtime_dir || fail 'XDG_RUNTIME_DIR is unavailable or not owned by this user'
  command -v systemd-run >/dev/null 2>&1 || fail 'systemd-run is required'

  local worker_copy unit_suffix
  umask 077
  worker_copy="$(mktemp "$XDG_RUNTIME_DIR/proton-vpn-omarchy-uninstall.XXXXXX")"
  install -m 0700 -- "$0" "$worker_copy"
  unit_suffix="${worker_copy##*.}"

  # --wait lets the panel report failures. The transient service remains
  # independent if unloading the plugin terminates this launcher near the end.
  if ! systemd-run --user --quiet --collect --wait --service-type=exec \
       --unit="proton-vpn-omarchy-uninstall-$unit_suffix" \
       /usr/bin/bash "$worker_copy" --worker; then
    rm -f -- "$worker_copy"
    fail 'clean uninstall did not complete'
  fi
}

remove_network_connections() {
  command -v nmcli >/dev/null 2>&1 || return 0

  local uuid stable_id connection_id
  while IFS= read -r uuid; do
    [[ $uuid =~ ^[0-9A-Fa-f-]{36}$ ]] || continue
    stable_id="$(nmcli -g connection.stable-id connection show uuid "$uuid" 2>/dev/null | head -n 1 || true)"
    connection_id="$(nmcli -g connection.id connection show uuid "$uuid" 2>/dev/null | head -n 1 || true)"
    if [[ $stable_id == "$OWNED_CONNECTION_STABLE_ID" ]] ||
       [[ $connection_id == 'pvpn-killswitch' ]] ||
       [[ $connection_id == 'pvpn-killswitch-perm' ]] ||
       [[ $connection_id == 'pvpn-killswitch-ipv6' ]]; then
      nmcli connection delete uuid "$uuid" >/dev/null 2>&1 || true
    fi
  done < <(nmcli -t -f UUID connection show 2>/dev/null || true)
}

remove_proton_sessions() {
  command -v secret-tool >/dev/null 2>&1 || return 0

  # Labels generated by keyring v3 encode the username before @Proton. Clear
  # only this agent's bounded SSO keys, never unrelated Proton applications.
  local label username
  while IFS= read -r label; do
    label="${label#label = }"
    username="${label%%@Proton:*}"
    case "$username" in
      proton-sso-accounts | proton-sso-account-[a-z2-7]*)
        secret-tool clear service Proton username "$username" >/dev/null 2>&1 ||
          fail 'a Proton VPN session could not be removed from Secret Service'
        ;;
    esac
  done < <(secret-tool search --all service Proton 2>/dev/null | grep '^label = ' || true)

  if secret-tool search --all service Proton 2>/dev/null |
     grep '^label = proton-sso-' >/dev/null; then
    fail 'a Proton VPN session remains in Secret Service'
  fi
}

remove_user_state() {
  local config_home data_home state_home cache_home runtime_dir path
  config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
  data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
  state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
  cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
  runtime_dir="${XDG_RUNTIME_DIR:-}"

  for path in \
    "$config_home/proton-vpn-omarchy" \
    "$data_home/proton-vpn-omarchy" \
    "$state_home/proton-vpn-omarchy" \
    "$cache_home/proton-vpn-omarchy" \
    "$config_home/Proton/VPN" \
    "$data_home/Proton/VPN" \
    "$state_home/Proton/VPN" \
    "$cache_home/Proton/VPN" \
    "$config_home/ProtonVPN for Linux community" \
    "$data_home/ProtonVPN for Linux community" \
    "$state_home/ProtonVPN for Linux community" \
    "$cache_home/ProtonVPN for Linux community" \
    "$config_home/systemd/user/proton-omarchy-agent.service.d"; do
    [[ $path == /* && $path != / ]] || continue
    rm -rf -- "$path"
  done

  if [[ -n $runtime_dir && $runtime_dir == /* && $runtime_dir != / ]]; then
    rm -rf -- "$runtime_dir/proton-omarchy"
    rm -f -- "$runtime_dir/proton-omarchy.sock"
  fi
}

remove_empty_proton_parents() {
  local config_home data_home state_home cache_home path
  config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
  data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
  state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
  cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
  for path in "$config_home/Proton" "$data_home/Proton" \
              "$state_home/Proton" "$cache_home/Proton"; do
    rmdir --ignore-fail-on-non-empty -- "$path" 2>/dev/null || true
  done
}

remove_shared_qml_cache() {
  local cache_home qml_cache
  cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
  qml_cache="$cache_home/quickshell/qmlcache"
  [[ $qml_cache == /* && $qml_cache != / ]] || return 0
  # Quickshell hashes cache names, so individual files cannot be attributed
  # safely. This directory contains compiled cache only and is regenerated.
  rm -rf -- "$qml_cache"
}

worker() {
  [[ ${EUID:-$(id -u)} -ne 0 ]] || fail 'worker must run as the desktop user'
  valid_runtime_dir || fail 'worker has no valid runtime directory'
  trap 'rm -f -- "$0"' EXIT

  systemctl --user disable --now proton-omarchy-agent.service \
    proton-omarchy-agent.socket >/dev/null 2>&1 || true
  remove_network_connections
  remove_proton_sessions

  if command -v pacman >/dev/null 2>&1 && pacman -Q "$PACKAGE_NAME" >/dev/null 2>&1; then
    command -v pkexec >/dev/null 2>&1 || fail 'pkexec is required to remove the backend package'
    pkexec /usr/bin/pacman -Rns --noconfirm "$PACKAGE_NAME" >/dev/null ||
      fail 'backend package removal was cancelled or failed'
  fi

  remove_user_state
  remove_empty_proton_parents
  systemctl --user daemon-reload >/dev/null 2>&1 || true

  # Remove the frontend last. Omarchy unloads it immediately, while this copy
  # continues from XDG_RUNTIME_DIR until the transient unit exits.
  if [[ -e "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/$PLUGIN_ID" ||
        -L "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/$PLUGIN_ID" ]]; then
    command -v omarchy >/dev/null 2>&1 || fail 'the Omarchy plugin manager is unavailable'
    omarchy plugin remove "$PLUGIN_ID" --yes >/dev/null ||
      fail 'the Omarchy plugin could not be removed'
  fi

  remove_shared_qml_cache

  command -v notify-send >/dev/null 2>&1 &&
    notify-send 'Proton VPN for Omarchy' 'Clean uninstall completed.' >/dev/null 2>&1 || true
}

if [[ $mode == --launch ]]; then
  launch_worker
else
  worker
fi
